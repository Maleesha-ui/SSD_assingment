PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# Security Invariant: JWT_SECRET must be >= 32 bytes (256 bits) of cryptographic entropy
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_minimum_32_bytes_cryptographically_secure_random_hex_secret_here
# Optional transition secret for zero-downtime secret rotation:
# JWT_SECRET_PREVIOUS=your_previous_jwt_secret_here
NODE_ENV=production
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_email_app_password
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
